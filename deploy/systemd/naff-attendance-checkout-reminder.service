[Unit]
Description=naffAI attendance checkout reminder
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/naffAI
EnvironmentFile=/opt/naffAI/.env
ExecStart=/opt/naffAI/.venv/bin/python manage.py attendance_checkout_reminder
StandardOutput=append:/var/log/naffAI/attendance-checkout-reminder.log
StandardError=append:/var/log/naffAI/attendance-checkout-reminder.log

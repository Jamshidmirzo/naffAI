[Unit]
Description=naffAI daily lessons TG delivery (DM operators with yesterday's recap)
After=network.target docker.service naff-daily-lessons-generate.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/naffAI
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
EnvironmentFile=/opt/naffAI/.env
ExecStart=/opt/naffAI/backend/.venv/bin/python manage.py deliver_daily_lessons
User=root
StandardOutput=append:/var/log/naffAI/daily-lessons-deliver.log
StandardError=append:/var/log/naffAI/daily-lessons-deliver.log

[Install]
WantedBy=multi-user.target

# =============================================================================
# sip_trunk.env.example — пример конфига SIP-транка.
#
# Скопируй в sip_trunk.env, заполни, запусти:
#   sudo ./configure-sip-trunk.sh sip_trunk.env
#
# ВАЖНО: sip_trunk.env НЕ коммитить в git! (уже в .gitignore)
# =============================================================================

# Название провайдера латиницей (используется как идентификатор секции)
# Допустимо: beeline_business, uzcloud, ucall, zadarma
SIP_TRUNK_PROVIDER=beeline_business

# SIP-хост провайдера (даёт менеджер при подключении)
SIP_TRUNK_HOST=sip.beeline.uz
SIP_TRUNK_PORT=5060

# Транспорт: udp (стандарт), tcp, tls
# Для транков в UZ обычно udp; tls — если провайдер требует.
SIP_TRUNK_TRANSPORT=udp

# Креденшлы (от менеджера)
SIP_TRUNK_USERNAME=your_sip_login
SIP_TRUNK_PASSWORD=your_sip_password

# Твой корпоративный номер — будет отображаться клиенту при звонке
SIP_TRUNK_CALLER_ID=+998YY1234567

# =========================================================
# naffAI — sales tracker for a phone retail call-center
# Copy to .env and adjust before running `docker compose up`
# =========================================================

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-50+chars-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
DJANGO_TIME_ZONE=Asia/Tashkent
DJANGO_LANGUAGE_CODE=ru

# --- Database (PostgreSQL) ---
POSTGRES_DB=naffai
POSTGRES_USER=naffai
POSTGRES_PASSWORD=naffai
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS / Frontend origin ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Superuser bootstrap (used by entrypoint on first run) ---
DJANGO_SUPERUSER_USERNAME=dostik
DJANGO_SUPERUSER_PASSWORD=tostik
DJANGO_SUPERUSER_EMAIL=dostik@example.com

# --- Payroll defaults ---
PAYROLL_DEFAULT_THRESHOLD_UZS=50000000
PAYROLL_DEFAULT_PAYOUT_TYPE=percent     # fixed | percent | tiers
PAYROLL_DEFAULT_PAYOUT_VALUE=3.0        # for percent — 3.0 = 3% above threshold

# --- IMEI online lookup (optional) ---
IMEI_ONLINE_LOOKUP_ENABLED=0
IMEI_ONLINE_API_URL=https://alpha.imeicheck.com/api/modelBrandName
IMEI_ONLINE_API_KEY=

# --- Telegram bot (optional, phase 5) ---
TELEGRAM_BOT_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_API_BASE=http://web:8000

# --- Google Sheets sync (Этап A) ---
# Absolute path to a Google service-account JSON key with
# https://www.googleapis.com/auth/spreadsheets.readonly scope.
# The service account's e-mail must be shared into the spreadsheet.
# Leave empty to disable sheet sync (the management command will refuse
# to run instead of crashing).
GOOGLE_SHEETS_CREDENTIALS_JSON=

# --- Callback reminder policy (Этап A) ---
# Minutes after `remind_at` before a callback is considered overdue and
# starts blocking the operator from receiving new leads.
CALLBACK_OVERDUE_GRACE_MINUTES=30

# --- Operator password reversible encryption (Этап B) ---
# Fernet key used to (en|de)crypt the plaintext copy of each operator's
# password so managers can look it up on demand. REQUIRED in production.
# Generate a fresh one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In DEBUG=1 an ephemeral key is minted at startup if this is empty (with a warning).
OPERATOR_PASSWORD_ENCRYPTION_KEY=

# --- Telegram user-client / Telethon (Этап B) ---
# Get API credentials at https://my.telegram.org/apps (one pair for all operators)
TG_API_ID=
TG_API_HASH=
# Fernet key for encrypting Telethon session strings in DB.
# SEPARATE from OPERATOR_PASSWORD_ENCRYPTION_KEY.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TG_SESSION_ENCRYPTION_KEY=
# Voice transcription (0=skipped, 1=enabled via Whisper)
TG_TRANSCRIBE_VOICE=0
# Message retention in days
TG_MESSAGE_RETENTION_DAYS=90
# Telegram backfill (history sync upon operator auth)
TG_BACKFILL_SINCE=2026-07-01
TG_BACKFILL_CHAT_DELAY_MS=800
TG_BACKFILL_BATCH_SIZE=200
TG_BACKFILL_MAX_MESSAGES_PER_CHAT=10000
TG_STALE_RUNNING_TIMEOUT_MIN=5
# LLM provider for dialog analysis: gemini / openai / anthropic / none
LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google Gemini (AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Sentry DSN for production monitoring
SENTRY_DSN=

# Log directory (/var/log/naffAI in production)
LOG_DIR=

# --- Frontend (Vite reads VITE_ prefixed vars) ---
VITE_API_BASE_URL=http://localhost:8000/api
